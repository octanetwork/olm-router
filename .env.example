# ========================================================
# OLM Router Configuration
# Domains:
#   - Frontend Panel: olm.octx.space
#   - Primary API:     api-olm.octx.space
#   - Fallback/LTE:    wapi-olm.octx.space
# ========================================================

# Network & Ports
PORT=8045
HOST=0.0.0.0
NODE_ENV=production

# Base Domains (used for host-based virtual routing)
PANEL_DOMAIN=olm.octx.space
API_DOMAIN=api-olm.octx.space
WAPI_DOMAIN=wapi-olm.octx.space

# Upstream Proxy (for bypassing regional blocks, e.g. Xray/SOCKS5/HTTP)
UPSTREAM_PROXY=http://127.0.0.1:10859
BACKUP_PROXY=http://127.0.0.1:10809

# Security & Master API Key
ADMIN_TOKEN=olm-master-change-me-secret-token
REQUIRE_AUTH_FOR_API=false
RATE_LIMIT_PER_MINUTE=120
BURST_LIMIT=30

# Whitelisted IPs for wapi-olm (comma-separated IPs or CIDRs)
# Empty or '*' allows all with priority queue
WAPI_WHITELIST_IPS=*

# Google OAuth Antigravity Client Credentials
ANTIGRAVITY_CLIENT_ID=your-antigravity-client-id.apps.googleusercontent.com
ANTIGRAVITY_CLIENT_SECRET=your-antigravity-client-secret
OAUTH_PORT=51121

# Data Directory for tokens, accounts and stats
DATA_DIR=./data

# Append these sites to the existing production Caddyfile after backup.
# Never replace the sites for Remnawave, Lumen or other services.
olm.octx.space, api-olm.octx.space {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    reverse_proxy olm-router:8045 {
        header_up X-Real-IP {remote_host}
        header_up -X-Forwarded-For
        flush_interval -1
        transport http {
            response_header_timeout 120s
        }
    }
}
